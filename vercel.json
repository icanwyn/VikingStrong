{
  "rewrites": [
    {
      "source": "/api/supabase/:path*",
      "destination": "https://jhklcmxtvrinfntjwhaw.supabase.co/:path*"
    },
    { "source": "/student", "destination": "/student.html" },
    { "source": "/students", "destination": "/student.html" },
    { "source": "/students.html", "destination": "/student.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
